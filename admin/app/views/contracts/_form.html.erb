<%= form_with model: contract do |f| %>
  <%= render "shared/errors", object: contract %>
  <div class="field <%= 'field--error' if contract.errors[:kinds].any? %>">
    <%= f.label :kinds %>
    <div class="checks">
      <%= f.collection_check_boxes :kinds, Contract.kind_options, :last, :first do |b| %>
        <%= b.label { b.check_box + " " + b.text } %>
      <% end %>
    </div>
    <% contract.errors.full_messages_for(:kinds).each do |message| %><small class="error"><%= message %></small><% end %>
  </div>
  <div class="row">
    <%= field f, :client_id, :select, client_options, include_blank: "Choisir…", required: true %>
    <%= field f, :plan, :select, Contract.plan_options, include_blank: "–", hint: "Maintenance : #{Contract::PLAN_PRICES.map { |k, v| "#{Contract::PLANS[k]} #{v} €" }.join(' · ')} / mois" %>
  </div>
  <%= field f, :label, required: true, placeholder: "Hébergement Notranet Namur, petitkiwi.be…" %>
  <div class="row">
    <%= field f, :amount, :number_field, step: "0.01", required: true %>
    <%= field f, :cost, :number_field, step: "0.01", hint: "Ce que ça te coûte, même période" %>
    <%= field f, :period, :select, period_options %>
  </div>
  <div class="row">
    <%= field f, :starts_on, :date_field %>
    <%= field f, :next_billing_on, :date_field %>
    <%= field f, :status, :select, Contract.status_options %>
  </div>
  <div class="row">
    <%= field f, :project_id, :select, project_options(contract.client_id), include_blank: "Aucun" %>
    <%= field f, :fixed_cost_id, :select, FixedCost.order(:name).pluck(:name, :id), include_blank: "Aucun" %>
    <%= field f, :registrar, hint: "Nom de domaine" %>
  </div>
  <%= field f, :notes, :text_area, rows: 3 %>
  <div class="form-actions">
    <%= f.submit "Enregistrer", class: "button" %>
    <%= link_to "Annuler", contract.persisted? ? contract : contracts_path, class: "button button--ghost" %>
  </div>
<% end %>
